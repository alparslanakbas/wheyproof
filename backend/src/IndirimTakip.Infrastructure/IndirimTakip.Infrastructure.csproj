<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IndirimTakip.Core\IndirimTakip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned explicitly: this project compiles against Relational 10.0.10
         through Design (PrivateAssets), but Design doesn't flow, so the test
         project got the 10.0.4 that Npgsql 10.0.3 asks for (MSB3277 in CI).
         SQL translation lives in Relational; the real-PostgreSQL test must run
         the same version as production (security review, 26 Sept). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal classes. -->
    <InternalsVisibleTo Include="IndirimTakip.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Guide articles ship inside the assembly (see Articles/ArticleSeeder.cs).
         LogicalName is explicit: the default manifest name is derived from the
         folder path, and ArticleSeeder reads resources by this prefix. -->
    <EmbeddedResource Include="Articles\Content\*.html" LogicalName="articles/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
