# Veritabanı VM üzerinde, compose ağındaki "db" servisinde çalışıyor.
# Host'a port açılmadığı için adres servis adıyla veriliyor; TLS'e gerek yok
# (trafik makineden hiç çıkmıyor). POSTGRES_PASSWORD ile aynı değer olmalı.
CONNECTION_STRING=Host=db;Port=5432;Database=indirim_takip;Username=protein;Password=...;SSL Mode=Disable
# "db" servisinin kuracağı parola. Yalnızca bu dosyada tutulur, repoya girmez.
POSTGRES_PASSWORD=
ADMIN_API_KEY=
BREVO_API_KEY=
INDEXNOW_KEY=

# Markaların ortaklık programı takip kodları (ortaklık panelinden alınır).
# Boş bırakılırsa o markanın linklerine hiçbir şey eklenmez.
AFFILIATE_HARDLINE=
AFFILIATE_SSN=

# Dışarıda toplanan ürünleri kabul eden uç için anahtar (POST /api/ingest/...).
# Supplementler.com sunucumuzun datacenter aralığından Cloudflare managed
# challenge'ı ile karşılandığı için o kaynak geliştirme makinesinde toplanıp
# buraya gönderiliyor. Admin anahtarından AYRI olmalı.
# Üretmek için: openssl rand -hex 32
INGEST_API_KEY=
