# Copy to .env on the VM (~/wheyproof/.env). The real file never enters the repo.

# The database runs in this stack's "db" service; the host name is the service
# name and traffic never leaves the machine, so TLS isn't needed. The password
# must match POSTGRES_PASSWORD.
CONNECTION_STRING=Host=db;Port=5432;Database=wheyproof;Username=wheyproof;Password=...;SSL Mode=Disable
POSTGRES_PASSWORD=

# Admin API key (X-Admin-Key header). Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Cloudflare Access for /admin. Leave both empty to keep the token path closed.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Brevo transactional email. The sender domain must be verified in Brevo (SPF/DKIM).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=newsletter@wheyproof.com

# IndexNow key (not secret; served at /{key}.txt).
INDEXNOW_KEY=

# Affiliate tracking codes, one per brand, referenced from docker-compose.yml.
# AFFILIATE_GHOST=
